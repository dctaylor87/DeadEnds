@subsection standard.h

@defun strsave (CString) @arrow{} String
Save String in heap.
@end defun

@defun striptrail (String) @arrow{} void
Strip trailing white space.
@end defun

@defun _alloc (size_t len, CString file, int line) @arrow{} void*
Allocates memory.  Wrapper around @code{malloc}.  When allocations are
being logged, the file @code{file}, line number @code{likne}, and
length @code{len} will be logged.  Called by @code{stdalloc} if
@code{DEBUGALLOCS} is defined.
@end defun

@defun _free (void* ptr, String file, int line) @arrow{} void
Frees memory.  Wrapper around @code{free}.  When allocations are
being logged, the file @code{file}, line number @code{likne}, and
length @code{len} will be logged.  Called by @code{stdfree} if
@code{DEBUGALLOCS} is defined.
@end defun

@defun _realloc (void* ptr, size_t len, CString file, int line) @arrow{} void*
Reallocates memory.  Wrapper around @code{realloc}.  When allocations are
being logged, the file @code{file}, line number @code{likne}, and
length @code{len} will be logged.  Called by @code{stdrealloc} if
@code{DEBUGALLOCS} is defined.
@end defun

@defun _logAllocations (bool onOrOff) @arrow{} void
Turn allocation logging on and off.  If @code{onOrOff} is @code{true},
then logging of allocations is turned on.  Otherwise, it is turned
off.
@end defun

@defun _fatal (CString file, int line, CString msg, CString function) @arrow{} void
Called by the @code{fatal}, @code{FATAL}, and @code{ASSERT} macros.

Terminates the program with a message that includes the file name
@code{file}, the line number @code{line}, the function name
@code{function}, and a message @code{msg}.
@end defun

@subsection path.h

@defun fopenPath (CString fileName, CString mode, CString searchPath, CString suffix) @arrow{} FILE*
Tries to open a file using a path variable and optional suffix.
@end defun

@defun resolveFile (CString fileName, CString searchPath, CString suffix) @arrow{} CString
Tries to find a file within a colon-separated path list.  If not
found, and a suffix is provided, tries again with suffix appended.
@end defun

@defun pathMatch  (CString path1, CString path2) @arrow{} bool
Are paths the same?
Handles WIN32 filename case insensitivity.
@end defun

@defun pathConcatAllocate (CString dir, CString file) @arrow{} String
Add file & directory together into newly alloc'd
string & return.

@code{dir} -- directory (may be NULL.
@code{file} -- file (may be NULL.
@end defun

@defun pathConcat (CString dir, CString file, int utf8, String buffer, int buflen) @arrow{} String
Add file & directory together.
Handles trailing / in dir and/or leading / in file.
Returns no trailing / if file is NULL.

@code{dir}: --  directory (may be NULL)
@code{file} --  file (may be NULL)
@end defun

@defun isDirSep (char c) @arrow{} bool
Is @code{c} a directory separator character?
Handles WIN32 characters.
@end defun

@defun compressPath (CString path, int len) @arrow{} String
@end defun

@defun chopPath (CString path, String dirs) @arrow{} int
@end defun

@defun expandSpecialFilenameChars (String buffer, int buflen, int utf8) @arrow{} bool
@end defun
