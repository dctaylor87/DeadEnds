@subsection file.h

@defun openFile (CString path, CString mode) @arrow{} File*
Creates a File structure and opens the underlying UNIX file.  When a
File is opened it is given line mode by default.
@end defun

@defun closeFile (File*) @arrow{} void
Closes the UNIX file and deletes the File structure.
@end defun

