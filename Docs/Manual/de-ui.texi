@section feeback.h

This header file needs to be renamed and moved from the
@file{LLSupport} tree to the @file{UI} tree.

@defun msg_error (CString fmt, ...) @arrow{} void
Report an error.  Just calls @code{msg_outputv} with a
@code{MSG_LEVEL} or @code{MSG_ERROR}.
@end defun

@defun msg_info (CString fmt, ...) @arrow{} void
Report a message.  Just calls @code{msg_outputv} with a
@code{MSG_LEVEL} or @code{MSG_INFO}.
@end defun

@defun msg_status (CString fmt, ...) @arrow{} void
Report transitory state that should not be preserved.  Just calls
@code{msg_outputv} with a @code{MSG_LEVEL} or @code{MSG_STATUS}.
@end defun

@defun msg_errorlog (ErrorLog *errorLog) @arrow{} void
@end defun

@defun msg_output (MSG_LEVEL, CString fmt, ...) @arrow{} void
Just calls @code{msg_outputv}.
@end defun

@defun msg_outputv (MSG_LEVEL, CString fmt, va_list args) @arrow{} void
The functions above in this section call this function.  Which, in
turn, calls the current @code{uiio_outputv_func} function.
@end defun

@defun message (CString fmt, ...) @arrow{} void
@b{Deprecated.  Should not be used in new code.}
@end defun

@defun llwprintf (CString fmt, ...) @arrow{} void
Just calls llvwprintf.
@end defun

@defun llvwprintf (CString fmt, va_list args) @arrow{} void
Reports to stdout style output (used embedded carriage returns).
@end defun

