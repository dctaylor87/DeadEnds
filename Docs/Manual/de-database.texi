@section import.h / import.c

@defun getDatabaseFromFile (CString path, int vcodes, ErrorLog* errlog) @arrow{} Database*
Reads the @code{GEDCOM} file found in @code{path}, creates a database
and returns it.  If errors occur, null is returned and the errors are
logged in @code{errlog}.
@end defun

@defun getRecordListFromFile (CString path, IntegerTable* keymap, ErrorLog* elog) @arrow{} RootList*
This is used by the @acronym{GEDCOM} import code and when editing a
database, whether to modify existing records or to add new records.
@end defun

@section keylist.h / DoNotExist

@defun createKeyList (Database*) @arrow{} KeyList*
Create a KeyList with its compare and getkey functions.
@end defun

@defun insertInKeyList (KeyList*, String) @arrow{} void
Insert a key into a KeyList.
@end defun

@section refnindex.h

@defun addToRefnIndex (RefnIndex* index, CString refn, CString key) @arrow{} bool
Adds the REFN @code{refn} present in the record having key @code{key} into 
the RefnIndex @code{index}.
@end defun

@defun searchRefnIndex (RefnIndex* index, CString refn) @arrow{} CString
Searches RefnIndex @code{index} for REFN @code{refn}.  If found, it
returns its key, otherwise it returns null.
@end defun

@defun createRefnIndexEl (CString refn, CString key) @arrow{} RefnIndexEl*
Creates a new reference index entry.
@end defun

@defun createRefnIndex (void) @arrow{} RefnIndex*
Creates a RefnIndex.
@end defun

@defun deleteRefnIndex (RefnIndex*) @arrow{} void
Deletes a RefnIndex.
@end defun

@defun getReferenceIndex (RecordIndex* index, CString fname, IntegerTable* keymap, ErrorLog* elog) @arrow{}  RefnIndex*
Creates a reference index from the records in a Database.  It checks
that REFN values are defined once.
@end defun

@subsection Debugging
@defun showRefnIndex (RefnIndex*) @arrow{} void
Shows a RefnIndex.
@end defun

@section database.h / database.c

@deftypevar Database* currentDatabase
@end deftypevar

@defun createDatabase (CString fileName, RootList*, IntegerTable*, ErrorLog*) @arrow{} Database*
Create a database.
@end defun

@defun deleteDatabase (Database* database) @arrow{} void
Delete a database, freeeing its memory.  It is the the caller's
responsibility to ensure that the database is not in use before
deleting it.
@end defun

@defun getRecord (CString key, RecordIndex* index) @arrow{} GNode*
Get an arbitraray record from the database.
@end defun

@defun isEmptyDatabase (Database*) @arrow{} bool
Return true if the database has no persons or families.
@end defun

@defun numberPersons (Database* database) @arrow{} int
Return the number of person records in the database.
@end defun

@defun numberFamilies (Database* database) @arrow{} int
Return the number of family records in the database.
@end defun

@defun numberSources (Database* database) @arrow{} int
Return the number of source records in the database.
@end defun

@defun numberEvents (Database* database) @arrow{} int
Return the number of event records in the database.
@end defun

@defun numberOthers (Database* database) @arrow{} int
Return the number of other records in the database.
@end defun

@defun storeRecord (Database*, GNode*) @arrow{} bool
Add a record to the database.
@end defun

@defun summarizeDatabase (Database*) @arrow{} void
@end defun

@defun writeDatabase (String fileName, Database*) @arrow{} void
Writes the contents of a Database to a Gedcom file.
@end defun

@section database.h / DoNotExist

@defun databaseIsDirty (Database* database) @arrow{} bool
Returns true if the database is dirty;  false if the database is clean.
@end defun

@defun setDatabaseDirty (Database* database, bool dirty) @arrow{} void
Sets the database dirty state to value of 'dirty'.
@end defun

@defun getDatabaseDirty (Database* database) @arrow{} bool
Gets the database dirty state.
@end defun

@defun indexNames (Database*) @arrow{} void
Index person names after reading the Gedcom file.
@end defun

@defun keyToRecord (CString key, Database*) @arrow{} GNode*
Return a key's record
@end defun

@defun oldIndexNames (Database* database) @arrow{} void
Indexes all person names in a database.
@end defun

@defun getCount (void) @arrow{} int
@end defun

@section recordindex.h

@defun addToRecordIndex (RecordIndex*, GNode* root) @arrow{} void
Adds a GNode record tree to a RecordIndex.
@end defun

@defun addrefRecord (GNode* element) @arrow{} void
Increment the reference count of a GNode.
@end defun

@defun releaseRecord (GNode* element) @arrow{} void
Decrement the reference count of a GNode.
If it reaches zero, we do NOT free it.
If it is zero before we decrement, we ABORT.
@end defun

@defun createRecordIndex (void) @arrow{} RecordIndex*
Creates a RecordIndex. The delete function is null to prevent the
trees themselves from being deleted.
@end defun

@defun deleteRecordIndex (RecordIndex*) @arrow{} void
Deletes a RecordIndex.
@end defun

@defun searchRecordIndex (RecordIndex*, CString) @arrow{} GNode*
Searches a RecordIndex by key and returns the associated GNode tree.
@end defun

@defun showRecordIndex (RecordIndex*) @arrow{} void
For debgugging.  Shows the contents of a RecordIndex on stdout.
@end defun

@defmac FORRECORDINDEX (table, gnode, type)
Iterates a RecordIndex returning only GNode*s of a specific type.
@end defmac
@defmac ENDRECORDINDEX
@end defmac
