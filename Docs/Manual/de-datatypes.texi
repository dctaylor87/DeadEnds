@subsection hashtable.h

@defun createHashTable (CString(*getKey)(const void*), int(*compare)(CString, CString), void(*delete)(void*), int numBuckets) @arrow{} HashTable*
@end defun

@defun deleteHashTable (HashTable*) @arrow{} void
Deletes a HashTable. If the @code{HashTable} has a @code{delete}
function, it is called on the elements.
@end defun

@defun detailSearchHashTable (HashTable* table, CString key, int* phash, int* pindex) @arrow{} void*
Is a function at the bottom of HashTable's search stack.

@b{NOTE:} It may be better to return the Bucket rather than the hash.
@end defun

@defun searchHashTable (HashTable* table, CString key) @arrow{} void*
Searches HashTable @code{table} for @code{key}.  If found, the element
is returned.  Otherwise, @code{null} is returned.
@end defun

@defun addToHashTable (HashTable*, void* element, bool replace) @arrow{} void
Adds a new element to a HashTable.
@end defun

@defun firstInHashTable (HashTable*, int* bucketIndex, int* elementIndex) @arrow{} void*
Returns the first element in a hash table.  It works with
@code{nextInHashTable} to iterate the table, returning each element in
turn.
@end defun

@defun nextInHashTable (HashTable* table, int* bucketIndex, int* elementIndex) @arrow{} void*
Returns the next element in the HashTable @code{table}, using the
in/out state variables @code{bucketIndex} and @code{elementIndex} to
keep track of the state of the iteration.  If there are no more
elements, then @code{null} is returned.
@end defun

@defun lastInHashTable (HashTable* table, int* bucketIndex, int* elementIndex) @arrow{} void*
Returns the last element in the hash table @code{table}.  It works with
@code{previousInHashTable} to iterate the table.
@end defun

@defun previousInHashTable (HashTable*, int*, int*) @arrow{} void*
Returns the previous element in the hash table @code{table}, using the
in/out state variables @code{bucketIndex} and @code{elementIndex} to
keep track of the state of the iteration.  If there is no previous
element, then @code{null} is returned.
@end defun

@defun removeFromHashTable (HashTable* table, CString key) @arrow{} void
Remove the element having @code{key} from the HashTable @code{table}.
@end defun

@defun addrefHashTable (HashTable *table) @arrow{} void
Increments the reference count of @code{table}.
@end defun

@defun releaseHashTable (HashTable *table) @arrow{} void
Decrements the reference count of @code{table}, free if zero.
@end defun

@defun isInHashTable (HashTable*, CString key) @arrow{} bool
Returns whether an element with the given key is in the HashTable.
@end defun

@defun searchHashTableWithElement (HashTable* table, void* element) @arrow{} void*
Searches a HashTable for the element with the same key as the given element.
@end defun

@defun sizeHashTable (HashTable*) @arrow{} int
Returns the size (number of elements) in a hash table.
@end defun

@defun getHash (CString, int) @arrow{} int
Returns the hash code of a String.
@end defun

@defun iterateHashTable (HashTable*, void (*function)(void*)) @arrow{} void
Iterates a hash table and performs a function on each element. The elements
are visited in hash key order.
@end defun

@defun iterateHashTableWithPredicate (HashTable*, bool(*predicate)(void*)) @arrow{} int
Like @code{iterateHashTable}, it iterates a hash table. It runs a
predicate on each element returning the number of elements that match
the predicate.  Elements are visited in hash key order.
@end defun

@defun iterateHashTableWithPredicate2 (HashTable*, void *predicateArg, bool(*predicate)(void* element, void* extra)) @arrow{} int
Like @code{iterateHashTableWithPredicate}, it iterates a hash table,
running a predicate on each element and returning the number of
elements that matched the predicate.  But, the predicate takes an
extra argument -- to avoid the need to extra variables.
@end defun

@defun createBucket (void) @arrow{} Bucket*
Creates and returns an empty Bucket.
@end defun

@defun lengthBucket (Bucket* bucket) @arrow{} int
Returns the length of a Bucket.
@end defun

@defun appendToBucket (Bucket*, void* element) @arrow{} void
Adds a new element to the end of a bucket.
@end defun

@defun removeElement (HashTable*, void* element) @arrow{} void
Removes an element from a hash table. It does not use binary search in cases
where it should.
@end defun

@defun incrReferenceCountTable (HashTable *table, CString file, int line, CString function) @arrow{} void
Increments the reference count of a HashTable.  The @code{file},
@code{line}, and @code{function} arguments are for logging purposes
when debugging and reflect the file, line, and function of the caller.

Typically not called directly, but instead via the INCRTABLEREFCOUNT
macro.
@end defun

@defmac INCRTABLEREFCOUNT (table)
Calls @code{incrReferenceCountTable} to increment the reference count of @code{table}.
@end defmac

@subsection integertable.h

@defun createIntegerTable (int numBuckets) @arrow{} IntegerTable*
Creates a hash table having the specified number of buckets.  The hash
table keys are strings, the values are integers.
@end defun

@defun incrIntegerTable (IntegerTable* table, CString key) @arrow{} void
Retrieves the HashTable @code{table} entry having key @code{key},
increments its value, and stores it back into the table.  If the
element is not found, a new element is added having having a key of
@code{key} and a value of @code{1}.
@end defun

@defun insertInIntegerTable (IntegerTable*, CString key, int value) @arrow{} void
Inserts a string @code{key} into an into the integer table with a value of @code{value}.
@b{NOTE:} The @code{key} is not saved.
@end defun

@defun searchIntegerTable (IntegerTable*, CString key) @arrow{} int
Searches for @code{key} in an integer table and returns its integer value.
Returns @code{DeadEndsNAN} (== @code{__INT_MAX__}) if @code{key} is not there.
@end defun

@subsection list.h

@defun createList (CString(*g)(const void*), int(*c)(CString, CString), void (*d)(void*), bool sorted) @arrow{} List*
Creates an empty List having the specified getKey @code{g}, compare
@code{c}, and delete @code{d} functions.  If @code{sorted} is
@code{true}, the list is a sorted list.
